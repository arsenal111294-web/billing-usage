# ─── Supabase (без этих переменных приложение работает в демо-режиме) ───
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ключ шифрования API-ключей интеграций (AES-256-GCM). Любая длинная случайная строка:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Доступ к приложению ───
# Пароль для входа. Если не задан — вход открыт (допустимо только локально/в демо).
APP_PASSWORD=
# Секрет подписи сессионной cookie (по умолчанию производный от APP_PASSWORD)
SESSION_SECRET=

# Секрет для /api/cron/daily (Netlify Scheduled Function передаёт его в заголовке)
CRON_SECRET=

# Публичный URL приложения (для ссылок в письмах). На Netlify подставляется из URL.
APP_URL=http://localhost:3000

# Базовая валюта для итогов и опциональные курсы (JSON, сколько единиц валюты за 1 USD)
BASE_CURRENCY=USD
# EXCHANGE_RATES={"EUR":0.86,"RUB":82}

# ─── Уведомления ───
# Email через Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Billing Tracker <alerts@example.com>
EMAIL_TO=you@example.com

# Telegram-бот: токен от @BotFather и chat_id получателя
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
